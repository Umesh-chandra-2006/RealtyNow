# ============================================================
# RealtyNow - Environment Variables Template
# Copy this file to .env and fill in your actual values
# ============================================================

# ----------------------------------------
# Core / Supabase Database
# Replace with your actual project. Your anon key is public by design but
# should live in your local .env (gitignored), not in committed files.
# ----------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ----------------------------------------
# AI Assistant / OpenRouter Integration
# ----------------------------------------
VITE_AI_API_KEY=your_openrouter_or_ai_api_key_here

# ----------------------------------------
# Builder.io CMS Integration
# ----------------------------------------
VITE_PUBLIC_BUILDER_KEY=your_builder_io_key_here

# ----------------------------------------
# Optional Integrations & Services
# ----------------------------------------
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
VITE_SENTRY_DSN=
VITE_ANALYTICS_ID=

# ----------------------------------------
# App Metadata
# ----------------------------------------
VITE_APP_NAME=RealtyNow
VITE_APP_URL=https://www.realtynow.in


# ----------------------------------------
# MSG91 OTP Authentication — Widget config (frontend-safe; loads the
# MSG91 widget SDK in the browser, see src/lib/msg91.ts). Get these from
# the MSG91 dashboard's OTP Widget config screen for the "Realtynow" widget.
# ----------------------------------------
VITE_MSG91_WIDGET_ID=YOUR_MSG91_WIDGET_ID
VITE_MSG91_TOKEN_AUTH=YOUR_MSG91_WIDGET_TOKEN

# ----------------------------------------
# hCaptcha Production Security Key
# Live Site Key from https://dashboard.hcaptcha.com
# ----------------------------------------
VITE_HCAPTCHA_SITE_KEY=

# ----------------------------------------
# MSG91 OTP Authentication — server-side only (Supabase Edge Function
# secrets, set via `supabase secrets set`; never prefix with VITE_)
# ----------------------------------------
MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY
MSG91_TEMPLATE_ID=YOUR_MSG91_TEMPLATE_ID

# ----------------------------------------
# Firebase Cloud Messaging (Web Push) — frontend-safe config (Firebase's
# Web config is not a secret; it's protected by Firebase Security Rules,
# not by being hidden). Get these from Firebase Console → Project Settings
# → General → "Your apps" → Web app. VAPID key is under Project Settings
# → Cloud Messaging → Web configuration → "Web Push certificates".
# src/lib/firebase.ts reads these.
# ----------------------------------------
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIREBASE_VAPID_KEY=YOUR_WEB_PUSH_VAPID_KEY

# ----------------------------------------
# Firebase Admin SDK — server-side only (Supabase Edge Function secret,
# set via `supabase secrets set FIREBASE_SERVICE_ACCOUNT_JSON="$(cat key.json)"`;
# never prefix with VITE_, never commit the actual value)
# ----------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=

# ----------------------------------------
# Resend — Transactional Email (server-side only; Supabase Edge Function
# secrets via `supabase secrets set`, never prefix with VITE_). Used by
# supabase/functions/_shared/email.ts for invoices/notifications.
# ----------------------------------------
RESEND_API_KEY=YOUR_RESEND_API_KEY
# Verified sender. Defaults to "RealtyNow <onboarding@resend.dev>" if unset.
EMAIL_FROM=RealtyNow <no-reply@realtynow.in>


# ----------------------------------------
# Centralized Authorized Admin Phone Numbers (Optional override)
# Comma-separated list of authorized Admin mobile numbers (10-digit Indian format)
# ----------------------------------------
ADMIN_PHONE_NUMBERS=
VITE_ADMIN_PHONE_NUMBERS=

