# Local scratch/dev tooling and Supabase CLI temp state — never commit.
scratch/
supabase/.temp/

# Build-time image optimization output (regenerated by `npm run images` on
# every build from the source originals in public/).
public/optimized/

# Root dev/diagnostic scripts (may embed live Supabase anon JWT / project URLs).
/test_*.js
/test_*.mjs
/test_*.cjs

# Playwright artifacts (spec traces, screenshots, report) — regenerated on run.
playwright-report/
test-results/

# Generated lint/report dumps — regenerated on demand.
reports/
